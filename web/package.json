{
  "name": "caycanhmientay-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync-ds": "node scripts/sync-ds.mjs",
    "predev": "npm run sync-ds",
    "dev": "next dev",
    "prebuild": "npm run sync-ds && npm run db:setup",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "gen-views": "node scripts/gen-views.mjs",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "seo:sitemap": "tsx scripts/check-sitemap.mts",
    "seo:canonical": "tsx scripts/check-canonical.mts",
    "seo:metadata": "tsx scripts/check-metadata.mts",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.mts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "parse5": "^7.3.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
